@startuml
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #4B5563
skinparam activity {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #475569
  StartColor #334155
  EndColor #334155
}

start
:Analisis kebutuhan pengguna dan\nkontrak integrasi sistem;
:Perancangan scene, NavMesh,\nkontrol, dan struktur runtime;
:Pembuatan prototipe navigasi\ndan rendering rute;
:Evaluasi pada Unity Editor\ndan peramban WebGL;
while (Hasil evaluasi belum sesuai?) is (Ya)
  :Perbaikan rute, spawn, minimap,\ntutorial, dan optimasi scene;
  :Evaluasi ulang pada Unity Editor\ndan peramban WebGL;
endwhile (Tidak)
:Integrasi artefak WebGL\ndengan dashboard React;
:Pengujian ulang fungsi, integrasi,\ndan performa runtime;
stop
@enduml
