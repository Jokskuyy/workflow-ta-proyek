@startuml gambar-2-10-alur-perancangan-aset-data

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #3F3F3F
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityDiamondBackgroundColor #EDF3F8
skinparam ActivityDiamondBorderColor #555555

start
:Mengumpulkan kebutuhan\nserta referensi visual;
:Merancang ERD dan struktur\nentitas inti;
:Menetapkan kebutuhan kebijakan RLS\npada tingkat rancangan;
:Membuat struktur database\ndan mengisi data awal;
:Memilih Gedung Dewi Sartika\nsebagai contoh proses visual;
:Membuat bentuk, lantai,\nmaterial, dan objek pendukung;
:Menyusun prefab dan kelompok Pointer;
:Menetapkan kode lokasi pada data\ndan objek tujuan;
:Menempatkan asset pada scene utama;
:Menggunakan alat pemeriksa\nuntuk membandingkan nama;

while (Masih terdapat ketidaksesuaian?) is (Ya)
  :Menentukan sumber masalah\npada data atau objek;
  :Memperbaiki kode, data,\natau nama objek tujuan;
  :Mengulangi pemeriksaan;
endwhile (Tidak)

:Mendokumentasikan aset, data,\ndan hasil pemeriksaan;
stop

@enduml
