@startuml gambar-2-10-tahap-pengembangan
' Tahapan Metode Prototyping pada Pengembangan Sistem
' Sumber: BAB II - 2.3.1 Rencana Pengembangan

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam linetype ortho
skinparam nodesep 14
skinparam ranksep 20
skinparam Padding 5
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBackgroundColor #ECECEC
skinparam ActivityDiamondBorderColor #555555
skinparam NoteBackgroundColor #FAFAFA
skinparam NoteBorderColor #BBBBBB

start

:1. Pengumpulan Kebutuhan;
note right
  Tim memetakan masalah pengguna,
  batas data, dan kebutuhan tiap peran.
end note

:2. Perancangan Cepat;
note right
  Antarmuka, data, aset 3D, Unity,
  API, dan kontrak integrasi dirancang.
end note

repeat
  :3. Pembangunan Prototipe per Peran;
  note right
    Web dan Denah 2D, data dan aset,
    serta Unity dibangun sesuai ownership.
  end note

  :4. Integrasi dan Evaluasi Prototipe;
  note right
    Komponen disatukan melalui kode lokasi,
    API, file hasil build, Black Box, dan UAT.
  end note

  if (Kriteria fungsi dan integrasi terpenuhi?) then (Belum)
    :5. Perbaikan Berulang;
    note right
      Temuan dikembalikan kepada pemilik
      komponen, lalu hasilnya diintegrasikan ulang.
    end note
  endif
repeat while (Masih memerlukan perbaikan?) is (Ya) not (Tidak)

:Sistem terintegrasi setelah evaluasi dan perbaikan;
stop

@enduml
