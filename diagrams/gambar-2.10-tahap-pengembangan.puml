@startuml gambar-2-10-alur-perancangan-aset-data

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #3F3F3F
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityDiamondBackgroundColor #EDF3F8
skinparam ActivityDiamondBorderColor #555555

start
:Mengumpulkan referensi visual\ndan kebutuhan data;

fork
  :Mengamati bentuk, lantai,\nbukaan, warna, dan material;
  :Membuat serta menata aset\ndi Unity Editor;
  :Menyusun prefab, Pointer,\ndan GameObject tujuan;
fork again
  :Menginventarisasi gedung,\nfasilitas, fakultas, dan program studi;
  :Merancang entitas, atribut,\nrelasi, dan constraint;
  :Menyusun serta memeriksa seed;
end fork

:Menetapkan unity_object_name\npada data dan GameObject;
:Menjalankan pemeriksaan\nkonsistensi aset dan data;

while (Masih terdapat ketidaksesuaian?) is (Ya)
  :Menentukan sumber masalah\npada data atau scene;
  :Memperbaiki identifier, data,\natau nama GameObject;
  :Mengulangi pemeriksaan;
endwhile (Tidak)

:Mendokumentasikan aset, data,\ndan hasil pemeriksaan;
stop

@enduml
