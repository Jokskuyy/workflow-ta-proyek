@startuml gambar-2-16-sequence-validasi-aset-data

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam sequenceArrowColor #3F3F3F
skinparam sequenceLifeLineBorderColor #555555
skinparam sequenceLifeLineBackgroundColor #F5F5F5
skinparam participant {
  BackgroundColor #F5F5F5
  BorderColor #555555
}
skinparam actor {
  BackgroundColor #EDF3F8
  BorderColor #555555
}

actor "Dwikhi" as Designer
participant "DatabaseSyncChecker\n(dikembangkan Faiz)" as Checker
participant "/api/unity/names\n(dikembangkan Iman)" as API
database "Supabase\nPostgreSQL" as DB
participant "Scene Unity\nGameObject" as Scene

Designer -> Checker : Mulai pemeriksaan
activate Checker
Checker -> API : GET /api/unity/names
activate API
API -> DB : Ambil unity_object_name\ngedung dan fasilitas
activate DB
DB -->> API : Daftar identifier
deactivate DB
API -->> Checker : unityObjectNames[]
deactivate API

Checker -> Scene : Kumpulkan nama seluruh GameObject
activate Scene
Scene -->> Checker : Daftar nama pada scene aktif
deactivate Scene
Checker -> Checker : Bandingkan tanpa\nmembedakan kapitalisasi

alt Seluruh identifier sesuai
  Checker -->> Designer : Ringkasan nama yang cocok
else Terdapat ketidaksesuaian
  Checker -->> Designer : Daftar hanya di basis data\ndan hanya di scene
  Designer -> DB : Perbaiki data sesuai kewenangan
  Designer -> Scene : Perbaiki nama atau struktur aset
  Designer -> Checker : Jalankan pemeriksaan ulang
end

deactivate Checker

@enduml
