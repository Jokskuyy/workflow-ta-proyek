@startuml
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #475569
skinparam participant {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #FFFFFF
  GroupHeaderFontName "Times New Roman"
  GroupHeaderFontStyle plain
  GroupFontName "Times New Roman"
  GroupFontStyle plain
}

actor Pengguna as user
participant "Dashboard React" as react
participant "Unity WebGL\nBuildingDatabase" as unity
participant "Vercel API" as api
database "Supabase" as supabase
participant "NavigationReceiver" as receiver
participant "NavigationGuide" as guide
participant "Browser Bridge" as bridge

== Persiapan data runtime ==
unity -> api : GET /api/unity/data
api -> supabase : Membaca gedung dan fasilitas
supabase --> api : Data integrasi
api --> unity : Respons JSON
unity -> unity : Membentuk cache unity_object_name

== Perintah navigasi ==
user -> react : Memilih tujuan
react -> receiver : SendMessage NavigateTo(target)
receiver -> unity : Mencari target pada cache
alt Target ditemukan
  receiver -> guide : Memulai rute NavMesh
  guide -> guide : Menghitung dan memperbarui rute
  alt Pengguna tiba secara normal
    guide -> receiver : CompleteNavigation(target)
    receiver -> bridge : OnNavigationCompleted(JSON target)
    bridge -> react : CustomEvent OnNavigationCompleted
    react -> react : Memvalidasi tujuan aktif
    react --> user : Menampilkan notifikasi tiba
  else Pengguna membatalkan
    react -> receiver : SendMessage StopNavigation()
    receiver -> guide : Menghapus rute
    note right of receiver
    Tidak mengirim callback kedatangan
    end note
  end
else Target tidak ditemukan
  receiver --> react : Navigasi tidak dimulai
  note right of receiver
  Tidak mengirim callback kedatangan
  end note
end
@enduml
