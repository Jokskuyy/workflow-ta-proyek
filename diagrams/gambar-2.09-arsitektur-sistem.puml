@startuml gambar-2-09-arsitektur-sistem
' Arsitektur Integrasi Dashboard Web, Supabase, dan Unity WebGL
' Menggantikan arsitektur lama (BuildingDataReceiver/BuildingClickHandler - deprecated)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #F2F2F2
  BorderColor #555555
}
skinparam component {
  BackgroundColor #F7F7F7
  BorderColor #666666
}
skinparam database {
  BackgroundColor #ECECEC
  BorderColor #555555
}
skinparam actor {
  BackgroundColor #ECECEC
  BorderColor #555555
}


actor "Pengguna Publik" as User
actor "Administrator" as Admin

rectangle "Browser" as Browser {
  component "Antarmuka Web React\n- Dashboard Publik\n- Panel Admin\n- Denah 2D dan Pencarian\n- Pilihan Bahasa" as React
  component "Denah 3D Unity WebGL\n- Lingkungan Kampus\n- Pencarian Rute NavMesh\n- Kontrol Karakter" as UnityCanvas
  React -right-> UnityCanvas : Perintah navigasi\n(kode lokasi Unity)
  UnityCanvas -left-> React : Notifikasi kedatangan\n(kode lokasi Unity)
}

rectangle "Vercel" as Vercel {
  component "Hosting Aplikasi Web dan\nFile Hasil Build Unity WebGL" as Static
  component "Fungsi API Vercel\n/api/unity/data\n/api/unity/names\n/api/buildings dan /api/rooms\n/api/health" as Serverless
}

rectangle "Layanan Opsional" as OptionalServices {
  component "Layanan Express\n- Perantara Analitik\n- Pembatasan Permintaan" as Express
  component "Layanan Analitik Umami\n(Dikelola Mandiri)" as Umami
  Express -right-> Umami : Teruskan data analitik
}

database "Supabase\n- Database PostgreSQL\n- Autentikasi\n- Kebijakan Akses Data" as Supabase

' Alur pengguna
User --> React : Buka dashboard dan denah
Admin --> React : Masuk dan kelola data

' Frontend ke layanan
React --> Static : Muat aplikasi dan aset denah 3D
React --> Supabase : Autentikasi dan pengelolaan data\n(dibatasi kebijakan akses)

' Unity menarik data sendiri (runtime)
UnityCanvas --> Serverless : Ambil data lokasi\nGET /api/unity/data

' Serverless ke database
Serverless --> Supabase : Ambil data gedung dan fasilitas

' Jalur analitik alternatif, bukan dependensi UI aktif
React ..> Express : Jalur analitik opsional\n(jika diaktifkan)

@enduml
