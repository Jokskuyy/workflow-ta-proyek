@startuml gambar-2-09-arsitektur-integrasi-aset-data

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #3F3F3F
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #555555
}
skinparam component {
  BackgroundColor #F7F7F7
  BorderColor #555555
}
skinparam database {
  BackgroundColor #EDF3F8
  BorderColor #4A667A
}

rectangle "Browser" {
  component "React SPA\nDashboard publik dan admin\n(Iman)" as React
  component "Unity WebGL\nRuntime navigasi\n(Faiz)" as Unity
}

database "Supabase PostgreSQL\nData gedung, fasilitas,\nfakultas, dan program studi\n(Rancangan inti: Dwikhi)" as DB

component "Vercel Serverless Functions\n/api/unity/data\n/api/unity/names\n(Iman)" as API

rectangle "Unity Editor" {
  component "Aset 3D, prefab, Pointer,\ndan GameObject tujuan\n(Dwikhi)" as Assets #EAF5EA
  component "DatabaseSyncChecker\n(Faiz; digunakan Dwikhi)" as Checker
}

React --> DB : Supabase Auth dan CRUD langsung
API --> DB : Query data dan identifier
Unity --> API : GET /api/unity/data
Checker --> API : GET /api/unity/names
Checker --> Assets : Bandingkan nama GameObject

React --> Unity : SendMessage\nNavigateTo(unity_object_name)
Unity --> React : OnNavigationCompleted\nJSON unity_object_name

DB ..> Assets : Kontrak pemetaan\nunity_object_name

note bottom of DB
  SQL diintegrasikan ke repositori web oleh Iman.
  RLS, autentikasi, layanan audit, dan deployment
  berada di luar kontribusi Dwikhi.
end note

@enduml
