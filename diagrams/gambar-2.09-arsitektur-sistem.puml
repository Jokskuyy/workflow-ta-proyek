@startuml
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #475569
skinparam rectangle {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
}

left to right direction

actor "Pengguna" as user

rectangle "Vercel Static Hosting" as vercel {
  rectangle "Dashboard React\nPublik dan Admin" as react
  rectangle "Denah 2D\nGraf dan A*" as map2d
  rectangle "Unity WebGL\nRuntime 3D" as unity
}

rectangle "Vercel Serverless Functions" as api {
  rectangle "GET /api/unity/data" as runtimeApi
  rectangle "GET /api/unity/names" as editorApi
  rectangle "GET /api/health" as healthApi
}

database "Supabase\nAuth, data, dan analitik" as supabase
rectangle "DatabaseSyncChecker\nUnity Editor" as checker
rectangle "Express Proxy\ndan Rate Limiter" as express
rectangle "Umami\nOpsional" as umami

user --> react : Mengakses dashboard
react --> map2d : Memilih mode 2D
react --> unity : Memuat mode 3D
react --> supabase : Auth dan CRUD langsung
react --> supabase : Pencatatan analitik aplikasi
unity --> runtimeApi : Mengambil data runtime
runtimeApi --> supabase : Membaca gedung dan fasilitas
checker --> editorApi : Memeriksa identifier editor
editorApi --> supabase : Membaca nama objek
react --> unity : NavigateTo / StopNavigation\nSetSpawn / SetDevice
unity --> react : OnNavigationCompleted\nJSON unity_object_name\nhanya setelah tiba normal
express ..> umami : Proxy analitik opsional
react ..> express : Jalur opsional
healthApi --> supabase : Memeriksa layanan

note bottom of unity
Pembatalan dan target yang tidak ditemukan
tidak mengirim callback kedatangan.
end note
@enduml
