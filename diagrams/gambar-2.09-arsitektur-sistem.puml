@startuml gambar-2-09-arsitektur-sistem
' Gambar 2.9 - Diagram Arsitektur Sistem (versi terkini, mengacu PRD)
' Menggantikan arsitektur lama (BuildingDataReceiver/BuildingClickHandler - deprecated)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #F2F2F2
  BorderColor #555555
}
skinparam component {
  BackgroundColor #F7F7F7
  BorderColor #666666
}
skinparam database {
  BackgroundColor #ECECEC
  BorderColor #555555
}
skinparam actor {
  BackgroundColor #ECECEC
  BorderColor #555555
}


actor "Pengguna Publik" as User
actor "Administrator" as Admin

rectangle "Browser (Klien)" as Browser {
  component "React SPA\n(Vite)\n- Dashboard Publik\n- Admin Panel\n- Denah 2D + Pencarian\n- Multi-bahasa" as React
  component "Unity WebGL Canvas\n- Scene 3D Kampus\n- NavMesh Pathfinding\n- First-person Control" as UnityCanvas
  React -right-> UnityCanvas : SendMessage\n(NavigationReceiver, NavigateTo)\n+ unity_object_name
  UnityCanvas -left-> React : OnNavigationCompleted\nJSON unity_object_name\n(validasi tujuan aktif)
}

rectangle "Vercel" as Vercel {
  component "Static Hosting\n(dist/, unity-builds/)" as Static
  component "Serverless Functions\n/api/unity/data\n/api/unity/names\n/api/buildings, /api/rooms\n/api/health" as Serverless
}

rectangle "Layanan Operasional Opsional" as OptionalServices {
  component "Express.js (:3001)\n- Proxy API Umami\n- Rate limiter" as Express
  component "Umami Analytics\n(Self-hosted Docker)" as Umami
  Express -right-> Umami : proxy analitik
}

database "Supabase Cloud\n- PostgreSQL\n- Auth (JWT)\n- Row Level Security" as Supabase

' Alur pengguna
User --> React : Akses dashboard & denah
Admin --> React : Login & CRUD data

' Frontend ke layanan
React --> Static : Muat aset (SPA + WebGL)
React --> Supabase : Auth, query, CRUD, analitik\n(dibatasi RLS)

' Unity menarik data sendiri (runtime)
UnityCanvas --> Serverless : HTTP GET /api/unity/data

' Serverless ke database
Serverless --> Supabase : Query data

' Jalur analitik alternatif, bukan dependensi UI aktif
React ..> Express : jalur analitik opsional\n(jika diaktifkan)

@enduml
