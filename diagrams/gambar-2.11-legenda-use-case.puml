@startuml gambar-2-11-legenda-use-case
' Legenda Simbol pada Use Case Diagram
' Sumber: BAB II - 2.3.3 (legenda simbol use case)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam ArrowColor #444444
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor #555555
}
skinparam actor {
  BackgroundColor #ECECEC
  BorderColor #555555
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #999999
}


actor "Aktor" as A
usecase "Fungsi Sistem\n(Use Case)" as U
rectangle "Batas Sistem" as Bnd

A -[hidden]down- U
U -[hidden]down- Bnd

legend right
  | Simbol | Notasi | Keterangan |
  | Aktor | Gambar orang | Pengguna atau sistem lain yang berinteraksi dengan sistem |
  | Use Case | Elips | Fungsi atau layanan yang tersedia pada sistem |
  | Batas Sistem | Persegi panjang | Ruang lingkup / batas cakupan sistem |
  | Hubungan aktor | Garis lurus | Hubungan interaksi antara aktor dan fungsi sistem |
  | Relasi include | Garis putus dan panah | Fungsi sistem selalu menyertakan fungsi lain |
  | Relasi extend | Garis putus dan panah | Fungsi tambahan memperluas fungsi dasar pada kondisi tertentu |
endlegend

@enduml
