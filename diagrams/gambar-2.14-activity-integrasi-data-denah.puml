@startuml gambar-2-14-activity-integrasi-data-denah
' Activity Diagram Integrasi Denah 2D dan 3D
' Sumber: BAB II - 2.2 & 2.3.3 Activity Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 18
skinparam Padding 4
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBackgroundColor #ECECEC
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneTitleFontColor #333333
skinparam SwimlaneBorderColor #999999

|Pengguna Publik|
start
:Mengakses Dashboard Publik;

|Antarmuka React|
:Memuat informasi dan data lokasi;

|Pengguna Publik|
:Membuka pemilih mode denah;
if (Mode yang dipilih?) then (Denah 2D)
  :Memilih gedung awal dan tujuan;
  |Antarmuka React|
  :Memuat jaringan jalur\ndan pintu masuk gedung;
  :Menghitung rute A*;
  :Menampilkan garis rute 2D;
else (Denah 3D)
  |Antarmuka React|
  :Memuat file hasil build\nUnity WebGL;
  |Unity WebGL|
  :Mengambil data lokasi melalui API;
  :Mencocokkan kode lokasi\ndengan objek tujuan;
  |Pengguna Publik|
  :Memilih lokasi awal dan tujuan;
  |Antarmuka React|
  :Mengirim kode tujuan ke Unity;
  |Unity WebGL|
  :Menjalankan navigasi;
  if (Tujuan tercapai secara normal?) then (Ya)
    :Mengirim pesan kedatangan;
    |Antarmuka React|
    :Memvalidasi tujuan aktif;
    :Menampilkan notifikasi tiba;
  else (Tidak)
    :Menghentikan atau mengganti navigasi\ntanpa notifikasi kedatangan;
  endif
endif

stop

@enduml
