@startuml gambar-2-14-activity-integrasi-data-denah
' Gambar 2.14 - Activity Diagram: Integrasi Data Denah
' Alur aktual pemilihan Denah 2D/3D dan integrasi React-Unity
' Sumber: BAB II - 2.2 & 2.3.3 Activity Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #444444
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBackgroundColor #ECECEC
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneTitleFontColor #333333
skinparam SwimlaneBorderColor #999999


|Pengguna|
start
:Mengakses Public Dashboard;

|React SPA|
:Muat antarmuka dan data publik dari Supabase;

|Pengguna|
:Membuka pemilih mode denah;
if (Mode yang dipilih?) then (Denah 2D)
  :Pilih gedung awal dan tujuan;
  |React SPA|
  :Muat node, edge, marker, dan entrance;
  :Hitung rute A*;
  :Tampilkan garis rute 2D;
else (Denah 3D)
  |React SPA|
  :Muat artefak Unity WebGL dari Vercel;
  |Unity Runtime|
  :GET /api/unity/data;
  :Petakan unity_object_name ke GameObject;
  |Pengguna|
  :Pilih lokasi awal dan tujuan;
  |React SPA|
  :SendMessage NavigationReceiver.NavigateTo;
  |Unity Runtime|
  :Jalankan navigasi menuju target;
  if (Tiba melalui completion normal?) then (Ya)
    :CompleteNavigation mengirim\nOnNavigationCompleted JSON;
    |React SPA|
    :Validasi unity_object_name terhadap\nactiveNavigationRef;
    :Tampilkan notifikasi tiba;
  else (Dibatalkan atau target berubah)
    :Hentikan atau ganti navigasi\ntanpa callback tiba;
  endif
endif

stop

@enduml
