@startuml
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #475569
skinparam activity {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #475569
  StartColor #334155
  EndColor #334155
}

start
:Pengguna membuka dashboard React;
:Pengguna memilih mode denah;
if (Mode yang dipilih?) then (Denah 2D)
  :React memuat simpul, sisi,\ndan titik gedung;
  :Pengguna memilih titik awal\ndan tujuan;
  :Sistem menghitung rute\ndengan algoritma A*;
  :Denah 2D menampilkan rute;
else (Denah 3D)
  :React memuat Unity WebGL;
  :Unity mengambil data dari\nGET /api/unity/data;
  :Unity membentuk cache target\nberdasarkan unity_object_name;
  :Pengguna memilih spawn\ndan tujuan;
  :React mengirim NavigateTo,\nSetSpawn, atau SetDevice;
  :Unity menghitung dan\nmenampilkan rute NavMesh;
  if (Navigasi berakhir?) then (Tiba normal)
    :Unity mengirim OnNavigationCompleted\ndengan JSON unity_object_name;
    :React memvalidasi tujuan aktif\ndan menampilkan notifikasi;
  else (Dibatalkan atau target tidak ditemukan)
    :Unity menghentikan proses\ntanpa pemberitahuan tujuan tercapai;
  endif
endif
stop
@enduml
