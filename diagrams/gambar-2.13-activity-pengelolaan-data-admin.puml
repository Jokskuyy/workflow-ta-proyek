@startuml gambar-2-13-activity-pengelolaan-data-admin
' Activity Diagram Pengelolaan Data oleh Administrator
' Sumber: BAB II - 2.3.3 Activity Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 18
skinparam Padding 4
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBackgroundColor #ECECEC
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneTitleFontColor #333333
skinparam SwimlaneBorderColor #999999

|Administrator|
start
:Membuka halaman masuk\ndan memasukkan kredensial;

|Antarmuka React|
:Mengirim kredensial;

|Supabase Auth dan Database|
:Memverifikasi kredensial;
if (Kredensial valid?) then (Tidak)
  |Antarmuka React|
  :Menampilkan pesan kesalahan;
  stop
else (Ya)
  |Antarmuka React|
  :Membuka Panel Admin;
endif

|Administrator|
:Memilih modul dan operasi data;
:Mengisi formulir atau\nmengonfirmasi penghapusan;

|Antarmuka React|
:Memeriksa isian dan konfirmasi;
if (Isian dan konfirmasi valid?) then (Tidak)
  :Menampilkan validasi\natau membatalkan operasi;
  stop
else (Ya)
  :Mengirim operasi data\nmenggunakan sesi admin;
endif

|Supabase Auth dan Database|
:Memeriksa sesi dan RLS;
:Menjalankan operasi data;
if (Operasi berhasil?) then (Tidak)
  |Antarmuka React|
  :Menampilkan respons kesalahan;
  stop
else (Ya)
  |Antarmuka React|
  if (Operasi mengubah data?) then (Ya)
    :Mencatat riwayat melalui\nlayanan aplikasi;
    |Supabase Auth dan Database|
    :Menyimpan riwayat perubahan;
  endif
  |Antarmuka React|
  :Memuat ulang tabel tampilan;
  :Menampilkan notifikasi berhasil;
endif

stop

@enduml
