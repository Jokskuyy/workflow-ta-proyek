@startuml gambar-2-13-activity-pengelolaan-data-admin
' Gambar 2.13 - Activity Diagram: Pengelolaan Data oleh Admin
' Sumber: BAB II - 2.3.3 Activity Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #444444
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityDiamondBackgroundColor #ECECEC
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneTitleFontColor #333333
skinparam SwimlaneBorderColor #999999

title Gambar 2.13 - Activity Diagram: Pengelolaan Data oleh Admin

|Administrator|
start
:Membuka halaman Login Admin;
:Memasukkan kredensial;

|React SPA|
:Kirim kredensial langsung ke Supabase Auth;

|Supabase|
:Verifikasi kredensial;
if (Kredensial valid?) then (Tidak)
  |React SPA|
  :Tampilkan pesan kesalahan;
  stop
else (Ya)
  |React SPA|
  :Buka akses Admin Dashboard;
endif

|Administrator|
:Memilih modul dan operasi data;
:Mengisi formulir atau mengonfirmasi penghapusan;

|React SPA|
:Validasi input dan konfirmasi;
if (Input valid dan operasi dikonfirmasi?) then (Tidak)
  :Tampilkan validasi atau batalkan operasi;
  stop
else (Ya)
  :Jalankan query/CRUD melalui Supabase SDK;
endif

|Supabase|
:Terapkan sesi Auth dan kebijakan RLS;
:Jalankan operasi database;
if (Operasi berhasil?) then (Tidak)
  |React SPA|
  :Tampilkan respons kesalahan;
  stop
else (Ya)
  |React SPA|
  if (Operasi mengubah data?) then (Ya)
    :Panggil service pencatatan audit aplikasi;
    |Supabase|
    :Simpan audit log sesuai akses yang tersedia;
    |React SPA|
  endif
  :Perbarui cache dan tabel;
  :Tampilkan notifikasi berhasil;
endif

stop

@enduml
