@startuml gambar-2-12-use-case-diagram
' Gambar 2.12 - Use Case Diagram
' Sumber: BAB II - 2.2.1 Kebutuhan Fungsional & 2.3.3 Use Case

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #444444
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor #555555
  ArrowColor #444444
}
skinparam actor {
  BackgroundColor #ECECEC
  BorderColor #555555
}


left to right direction

actor "Pengguna Publik\n(User)" as User
actor "Administrator" as Admin
actor "Unity Runtime\n(WebGL 3D)" as UnityRuntime
actor "Tooling Unity Editor" as UnityEditor

rectangle "Sistem Integrasi Denah Virtual UPNVJ" {
  usecase "Melihat Informasi Utama,\nStatistik, dan Aset" as UC1
  usecase "Mencari Gedung\natau Fasilitas" as UC2
  usecase "Membaca Tutorial, FAQ,\ndan Bantuan" as UC3
  usecase "Memilih Denah\n2D atau 3D" as UC4
  usecase "Mengikuti Rute A*\npada Denah 2D" as UC5
  usecase "Menjalankan Navigasi\nUnity WebGL 3D" as UC6
  usecase "Mengganti Bahasa\n(ID / EN)" as UC7

  usecase "Login Admin\n(Supabase Auth)" as UC8
  usecase "Kelola Gedung, Fasilitas,\ndan Program Studi" as UC9
  usecase "Kelola Konfigurasi\nDenah 2D" as UC10
  usecase "Meninjau Analitik\ndan Audit Log" as UC11
  usecase "Konfirmasi\nHapus Data" as UC12

  usecase "Mengakses Data Runtime\n(GET /api/unity/data)" as UC13
  usecase "Memeriksa Identifier\n(GET /api/unity/names)" as UC14
  usecase "Memproses Callback Tiba\n(OnNavigationCompleted)" as UC15
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC5 ..> UC2 : <<include>>
UC6 ..> UC2 : <<include>>
UC9 ..> UC8 : <<include>>
UC10 ..> UC8 : <<include>>
UC11 ..> UC8 : <<include>>
UC12 ..> UC9 : <<extend>>

UnityRuntime --> UC13
UnityRuntime --> UC15
UnityEditor --> UC14

@enduml
