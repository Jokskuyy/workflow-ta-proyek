@startuml gambar-2-12-use-case-diagram
' Use Case Diagram Sistem Denah Virtual UPNVJ
' Sumber: BAB II - 2.2.1 Kebutuhan Fungsional & 2.3.3 Use Case

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 30
skinparam Padding 5
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor #555555
  ArrowColor #444444
}
skinparam actor {
  BackgroundColor #ECECEC
  BorderColor #555555
}

top to bottom direction

actor "Administrator" as Admin

rectangle "Sistem Integrasi Denah Virtual UPNVJ" {
  usecase "Melihat Informasi\nKampus" as UC1
  usecase "Mencari dan\nMenavigasi Lokasi" as UC2
  usecase "Mengakses Tutorial,\nFAQ, dan Bantuan" as UC3

  usecase "Mengakses Data\nGedung dan Fasilitas" as UCData

  usecase "Masuk ke\nPanel Admin" as UC4
  usecase "Mengelola Data Gedung,\nFasilitas, Program Studi,\ndan Konfigurasi Denah 2D" as UC5
  usecase "Meninjau Analitik dan\nRiwayat Perubahan" as UC6

  UC1 -[hidden]down- UC2
  UC2 -[hidden]down- UC3
  UC2 -[hidden]right- UCData
  UCData -[hidden]right- UC5
  UC4 -[hidden]down- UC5
  UC5 -[hidden]down- UC6
}

actor "Pengguna Publik" as User

User -[hidden]left- UC2
UC5 -[hidden]left- Admin

User -- UC1
User -- UC2
User -- UC3
User -- UCData

Admin -- UCData
Admin -- UC4
Admin -- UC5
Admin -- UC6

UC5 --> UCData : <<include>>

@enduml
