@startuml
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #475569
skinparam actor {
  FontName "Times New Roman"
  FontStyle plain
}
skinparam usecase {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam rectangle {
  FontName "Times New Roman"
  FontStyle plain
  BackgroundColor #FFFFFF
  BorderColor #475569
}

left to right direction
actor "Pengguna" as user
actor "Dashboard React" as react
actor "Pengembang Unity" as developer
actor "Vercel API" as api

rectangle "Modul Unity WebGL" {
  usecase "Memuat data runtime" as UC1
  usecase "Menerima perintah\ndari React" as UC2
  usecase "Memilih titik awal" as UC3
  usecase "Menjelajahi kampus 3D" as UC4
  usecase "Menghitung dan\nmenampilkan rute NavMesh" as UC5
  usecase "Menampilkan minimap\ndan tutorial" as UC6
  usecase "Menyelesaikan navigasi" as UC7
  usecase "Membatalkan navigasi" as UC8
  usecase "Memvalidasi identifier\ndi Unity Editor" as UC9
  usecase "Mengonfigurasi dan\nmembangun WebGL" as UC10
}

user --> UC3
user --> UC4
user --> UC6
user --> UC8
react --> UC2
react --> UC3
api --> UC1
developer --> UC9
developer --> UC10
UC2 ..> UC5 : <<include>>
UC5 ..> UC7 : <<include>>
UC1 ..> UC5 : menyiapkan target
UC3 ..> UC4 : <<include>>
UC4 ..> UC6 : <<include>>
@enduml
